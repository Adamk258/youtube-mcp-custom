# Copy to .env (or rely on the repo-root .env — this server auto-loads the first
# .env it finds walking up from mcp/youtube-mcp/).
#
# Add as many keys as you have — the server rotates through ALL of them and
# only errors when every key is quota-exhausted for the day.
# Each YouTube Data API v3 key = 10,000 units/day. search = 100 units/call,
# most other reads = 1 unit. So ~2 keys ≈ 200 searches/day + thousands of reads.

YOUTUBE_API_KEY=
YOUTUBE_API_KEY_2=
YOUTUBE_API_KEY_3=
# YOUTUBE_API_KEY_4=
# ...or one line:  YOUTUBE_API_KEYS=key1,key2,key3

# Optional shared-secret gate for the public tunnel URL.
# If set, every request must send  Authorization: Bearer <this value>
# (paste the same string into the connector's auth field).
# MCP_BEARER_TOKEN=

# MCP_HOST=127.0.0.1
# MCP_PORT=8765
